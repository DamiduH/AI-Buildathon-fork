# Copy this file to .env.local (for local dev) and fill in real values.
# .env.local is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Supabase (database) - Project Settings -> API in your Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY is the SECRET key, not the anon/publishable one.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA on the registration form) - dashboard.cloudflare.com
# For local dev you can use Cloudflare's official "always passes" test key
# pair instead of a real one:
# Site Key:   1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Admin dashboard access control
# ---------------------------------------------------------------------------
# Comma-separated list of Google account emails allowed to sign into /admin.
ADMIN_EMAILS=someone@example.com,someone-else@example.com

# ---------------------------------------------------------------------------
# Firebase Client Config (safe to expose to the browser; NOT secret)
# Used on the /admin/login page.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (SERVER-ONLY SECRET credentials)
# Used to verify Google sign-ins and issue session cookies on the backend.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
